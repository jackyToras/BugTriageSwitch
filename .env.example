POSTGRES_DB=switchboard
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard-local
DATABASE_URL=postgresql+psycopg://switchboard:switchboard-local@db:5432/switchboard
REDIS_URL=redis://redis:6379/0
VITE_API_URL=http://localhost:8000/api/v1
DEMO_PROCESSING_DELAY_SECONDS=2
# Optional Switch room mirror adapter. Use the Console-managed mirror agent's
# credentials file; the adapter reads compact room history through its relay.
# Keep this file private and never copy its bearer token into this .env file.
SWITCH_BASE_URL=
SWITCH_ROOM_ID=798664d5-c245-4a17-bbab-334d76eb3134
SWITCH_CREDENTIALS_HOST_PATH=
SWITCH_ADAPTER_RETRY_SECONDS=5
SWITCH_ADAPTER_POLL_SECONDS=5
